.compact-events{padding:8rpx 4rpx 150rpx}
.event-card{padding:24rpx 26rpx 16rpx;margin-bottom:20rpx;border-radius:26rpx;border:1rpx solid #e0e8dc;background:linear-gradient(135deg,#f6f9f2,#edf3e8);box-shadow:0 5rpx 16rpx #344b2d06}
.partner-card{background:linear-gradient(135deg,#fcf9f2,#f4eddf);border-color:#ebe1d0}
.event-card-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:42rpx}
.event-member{display:flex;align-items:center;gap:10rpx;min-width:0;font-size:22rpx;color:#526d53;font-weight:500}
.event-member>text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:220rpx}
.partner-card .event-member{color:#94794f}
.event-member-avatar{width:40rpx;height:40rpx;border-radius:50%;flex-shrink:0;border:2rpx solid #ffffff}
.event-card-time{font-size:21rpx;color:#86907e;font-variant-numeric:tabular-nums;flex-shrink:0}
.event-card-title{display:flex;align-items:center;gap:12rpx;margin-top:20rpx;color:#314a38}
.event-card-title>.icon{width:30rpx;height:30rpx;flex-shrink:0;opacity:.8}
.event-card-name{font-size:31rpx;font-weight:600;line-height:1.45;overflow-wrap:anywhere;min-width:0}
.event-duration{font-size:20rpx;font-weight:400;color:#6d8264;background:#e3eddc;padding:5rpx 12rpx;border-radius:10rpx;white-space:nowrap;margin-left:auto;flex-shrink:0}
.partner-card .event-duration{color:#917c58;background:#eee4d2}
.event-extra{display:block;font-size:22rpx;color:#86907e;margin-top:10rpx}
.card-note{display:block;font-size:25rpx;line-height:1.75;margin-top:14rpx;color:#65715f;white-space:pre-wrap;overflow-wrap:anywhere}
.note-clamped{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card-photos{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:20rpx}
.card-photos>view{width:calc((100% - 20rpx)/3);height:170rpx;border-radius:16rpx;overflow:hidden;background:#e6eadd;display:flex;align-items:center;justify-content:center;font-size:21rpx;color:#829077}
.card-photos.photos-1>view{width:100%;height:300rpx}
.card-photos.photos-2>view{width:calc((100% - 10rpx)/2);height:220rpx}
.card-photos image{width:100%;height:100%}
.card-actions{display:flex;align-items:center;justify-content:flex-end;gap:24rpx;margin-top:18rpx;padding-top:10rpx;border-top:1rpx solid #6d826412}
.card-link{background:transparent!important;padding:6rpx 0!important;margin:0!important;font-size:22rpx!important;color:#74876a!important;line-height:1.8!important;text-align:left}
.card-link::after{border:0}
.partner-card .card-link{color:#947f59!important}
.comment-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:20rpx}
.comment-tag{padding:10rpx 16rpx;border-radius:8rpx 18rpx 18rpx 18rpx;background:#ffffffb8;font-size:23rpx;line-height:1.55;overflow-wrap:anywhere;max-width:100%;box-sizing:border-box;color:#5f7059}
.comment-author{font-weight:500;color:#486b4d;margin-right:12rpx}
.partner-card .comment-author{color:#8a724f}
.comment-input{box-sizing:border-box;width:100%;height:150rpx;padding:20rpx;background:#eef2e8;border-radius:16rpx;font-size:27rpx}.comment-counter{text-align:right;font-size:22rpx;color:#819075;margin:12rpx 0 24rpx}

.home-style-row{display:flex;align-items:center;justify-content:flex-end;gap:12rpx;padding:0 4rpx 14rpx;flex-shrink:0;position:relative;z-index:1}.home-style-row .segmented{flex-shrink:0}

.event-list-empty{display:flex;flex-direction:column;align-items:center;gap:18rpx;padding:100rpx 0;color:#8b9880;font-size:24rpx}.event-list-empty image{width:48rpx;height:48rpx;opacity:.6}

@import "./borderless-theme.wxss";

@import "./landscape-theme.wxss";

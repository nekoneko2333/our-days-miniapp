
/* Landscape illustration is part of the page, never a card around each entry. */
.app-shell,.today-page,.content-scroll,.feed-page,.search-overlay,.focus-page{background:#faf7ef}
.today-page{padding-top:0;overflow:hidden}.home-landscape{position:relative;flex-shrink:0;height:230rpx;margin:0 -30rpx;overflow:hidden}.scene-image{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.couple-card{position:relative;z-index:1;border:0;background:transparent;margin:0 30rpx;padding:28rpx 0 0;overflow:visible}.profile-half.self,.profile-half.partner{align-items:flex-start;padding:4rpx 0;gap:12rpx;background:transparent}.profile-half.partner{padding-left:28rpx}.profile-copy{padding-top:4rpx}.name{font-size:27rpx;color:#294f43;font-weight:500}.weather{color:#667d6b;font-size:18rpx}.avatar{width:57rpx;height:57rpx;border:2rpx solid #faf7ef;padding:0}.partner .name{color:#8d6748}
.date-row{padding-top:7rpx}.date-title{font-size:32rpx;color:#2d4b3f}.quick-row{padding:10rpx 0 16rpx;border:0;gap:14rpx}.quick{color:#5b7d66!important;flex-direction:column;gap:7rpx;font-size:22rpx!important}.quick .icon{width:32rpx;height:32rpx;opacity:1}.home-style-row{padding-top:0;padding-bottom:2rpx}.home-style-row .segmented .active{border-color:#cd9063;color:#52715a}
.event-card,.event-card.partner-card{background:transparent;padding-top:22rpx;padding-bottom:18rpx;border-bottom:1rpx solid #dfe5d7;margin:0;border-radius:0;box-shadow:none}.event-card-title{margin-top:12rpx}.event-card-name{font-size:31rpx;color:#2f4d3e}.event-card-head{min-height:30rpx}.event-member{color:#598069}.partner-card .event-member{color:#b07b52}.event-card-time{color:#929b87}.card-note{color:#627462}.event-extra{color:#8c977f}.card-actions{margin-top:4rpx}.comment-tags{border-color:#bdceae}.comment-author,.partner-card .comment-author{color:#4e7d62}.comment-body{color:#6d7f64}.card-link,.partner-card .card-link{color:#74916c!important}.card-photos>view{border-radius:9rpx}
.scene-heading{height:220rpx;position:relative;margin:0;flex-shrink:0}.scene-heading>.section-heading{position:relative;z-index:1;padding:38rpx 30rpx 0;align-items:flex-start}.scene-heading .page-title{font-size:39rpx;color:#315749;font-weight:500;letter-spacing:2rpx}.scene-heading .segmented{margin-left:auto}.scene-heading .segmented .active{border-color:#cd9063}.calendar-toolbar{padding-top:10rpx}.calendar-agenda{border-color:#dfe5d7}.calendar-day{color:#526d59}.calendar-cell.chosen .calendar-day{background:#6d9276}.stats-dashboard{color:#466347}.stats-hero-value{color:#3c7055;font-weight:400}.stats-hero,.stats-card,.panel{background:transparent;border-color:#dfe5d7}.stats-track{background:#e8edde}.stats-track>view{background:#81a383}.stats-bar-track>view{background:#cdaa78}.stats-kinds{border-color:#dfe5d7}.stats-kinds button.selected{color:#527854;border-color:#cd9063!important}.settings-row{border-color:#e3e7da}.tabbar{background:#faf7ef;border-color:#e0e6d7}.tabbar .tab.active{color:#416e55}.today-page>.fab{background:#598373!important;color:#fff8e9;border:0;box-shadow:none}.badge{color:#93a183}.panel .secondary{background:transparent;border:0;border-bottom:1rpx solid #cddbc0;border-radius:0;padding-left:0;text-align:left}
.sheet,.study-sheet,.profile-sheet{background:#faf7ef}.comment-input{border-color:#cbd9bf}.reply-quote{color:#7f9577;border-color:#bacda9}.study-subject.selected{color:#507847!important;border-color:#87a874!important}.focus-ring>view{background:#faf7ef}.focus-page{isolation:isolate}.focus-scenery{position:absolute;left:0;bottom:0;width:100%;height:250rpx;z-index:-1;pointer-events:none}.focus-content{padding-bottom:200rpx}.timer-float{background:#faf7ef;border-color:#cbd8c0}.search-overlay>.section-heading{background:#eee9d7;padding-bottom:26rpx}.feed-controls{padding-top:20rpx}.feed-record{border-color:#dfe5d7}

.home-landscape{width:calc(100% + 60rpx)}.home-landscape .scene-image,.scene-heading .scene-image{display:block}.home-landscape .profile-half{padding-top:0}.home-landscape .couple-card{padding-top:24rpx}.scene-heading .scene-image{width:100%}

/* Soft selectors replace underlines; content stays on the open page. */
.segmented,.home-style-row .segmented{display:flex;gap:3rpx;padding:4rpx;background:#eeeede;border-radius:22rpx;align-items:center}
.segmented text,.home-style-row .segmented text{border:0;border-radius:18rpx;padding:9rpx 18rpx;color:#879077;line-height:1.5}
.segmented .active,.home-style-row .segmented .active,.scene-heading .segmented .active{border:0;background:#d5e1c8;color:#456044}
.scene-heading .segmented{background:#f7f3e6cc}
.stats-kinds{border:0;background:transparent;gap:8rpx;padding:6rpx 0;margin-bottom:18rpx}
.stats-kinds button{border:0!important;border-radius:20rpx!important;padding:12rpx 0!important;color:#869174}
.stats-kinds button.selected{border:0!important;background:#dce6ce!important;color:#4d6947;box-shadow:none}
.stats-members{gap:5rpx}.stats-members>text{border:0;border-radius:16rpx;padding:9rpx 13rpx;color:#8c947e}.stats-members>text.selected{border:0;background:#e9ead9;color:#61764e}
.stats-body{gap:8rpx}.stats-body button{border:0!important;border-radius:18rpx!important;color:#849173}.stats-body .selected{border:0!important;background:#e4e9d6!important;color:#58704a}
.filter{border:0;border-radius:18rpx;padding:10rpx 17rpx;margin-right:6rpx;background:transparent}.filter.active{border:0;background:#e0e8d2;color:#5c754c}
.study-subject{border:0!important;border-radius:16rpx!important;background:#f0f0e4!important;padding:18rpx 8rpx!important}.study-subject.selected{border:0!important;background:#dce6cd!important;color:#4b6a42!important}
.focus-presets button{border:0;border-radius:17rpx;background:#efefdf;padding:12rpx}.focus-presets button.selected{border:0;background:#dce6cd}.focus-duration input{border:0;background:#eeefdf;border-radius:10rpx}
.event-card,.event-card.partner-card{border:0;padding-top:26rpx;padding-bottom:26rpx}.card-actions{border:0}.panel,.stats-card,.stats-hero,.calendar-agenda,.feed-record{border:0}.stats-card{padding:30rpx 0 22rpx}.stats-metrics{border:0}.stats-metrics>view{border:0}.settings-row{border:0;padding:24rpx 0}.panel{padding:30rpx 0}.status-card{border:0}.calendar-cell{border:0}.agenda-record{border:0;padding-top:22rpx;padding-bottom:22rpx}.period-entry{border:0}.feed-search{border:0;background:#eeefdf;border-radius:16rpx;padding:18rpx}.panel .secondary{border:0;border-radius:14rpx;background:#eceede;text-align:center;padding:16rpx 22rpx}
.comment-tags{border:0;padding-left:16rpx;margin-top:14rpx}.comment-tag{border:0}.reply-quote{border:0;background:#eff0e0;border-radius:12rpx;padding:16rpx}.comment-input{border:0;background:#f0f0e4;border-radius:16rpx;padding:18rpx}.profile-sheet .field{border:0}.tabbar{border:0}.tabbar .tab{position:relative}.tabbar .tab.active{color:#4d704b}.tabbar .tab.active image{background:#e1e9d3;border-radius:12rpx;box-shadow:0 0 0 8rpx #e1e9d3}
/* Warm green for self, soft sand for partner: no cool blue tint. */
.timeline-ground .ground-self{background:#f0f1df}.timeline-ground .ground-partner{background:#f6efdf}
.timeline-canvas .mine .event-inner{background:#dce5c8;border-color:#a2b18a;border-radius:10rpx;box-shadow:none}.timeline-canvas .mine.point-event .event-inner{background:#e8edd9;border-color:#bcc9a4}.timeline-canvas .mine .event-time{color:#7c8b66}.timeline-canvas .mine .event-title{color:#536644}
.timeline-canvas .sand .event-inner{background:#eee0c7;border-color:#cfb995;border-radius:10rpx;box-shadow:none}.timeline-canvas .sand.point-event .event-inner{background:#f5eddd;border-color:#dfccac}.timeline-divider{width:1rpx;background:#dddcc6;box-shadow:none}.hour-line{border-color:#c4cbb333;opacity:.55}.now-line{background:#c5987780}

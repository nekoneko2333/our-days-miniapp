<view class="app-shell {{timer ? 'has-timer' : ''}}">
  <view wx:if="{{mode === 'demo'}}" class="mode-bar"><text>演示模式</text><text class="link" bindtap="connect">连接云端 ↗</text></view>
  <view wx:if="{{error}}" class="error-bar" bindtap="refresh">{{error}} · 点击重试</view>
  <view wx:if="{{busy}}" class="loading-line"></view>
  <view hidden="{{tab !== 'timeline'}}" class="today-page motion-{{motionSide}}">
    <view wx:if="{{rippleActive}}" class="avatar-ripple ripple-{{rippleSide}}"></view>
    <view class="home-landscape"><image class="scene-image" src="/assets/scene-home.svg" mode="scaleToFill"/><view class="couple-card card-view-{{view}}">
      <view class="profile-half self {{homeStyle === 'events' || view !== 'partner' ? 'selected' : ''}}" bindtap="avatarTap" data-side="me" hover-class="tap">
        <image class="avatar" src="{{me.avatarUrl || '/assets/avatar-me.svg'}}" mode="aspectFill" />
        <view class="profile-copy"><text class="name">{{meLabel}}</text><text class="weather">{{me.city.name}} · {{meWeather}}</text></view>
      </view>
      <view class="profile-half partner {{homeStyle === 'events' || view !== 'me' ? 'selected' : ''}}" bindtap="avatarTap" data-side="partner" hover-class="tap">
        <image class="avatar" src="{{partner.avatarUrl || '/assets/avatar-partner.svg'}}" mode="aspectFill" />
        <view class="profile-copy"><text class="name">{{partner ? partnerLabel : '未绑定'}}</text><text class="weather">{{partner ? partner.city.name + ' · ' + partnerWeather : '绑定成员'}}</text></view>
      </view>
    </view>
    </view>
    <view class="date-row"><button class="arrow" bindtap="previous" aria-label="前一天">‹</button><picker mode="date" value="{{date}}" bindchange="pickDate"><text class="date-title">{{dateLabel}}</text></picker><button class="arrow" bindtap="next" aria-label="后一天">›</button><button class="search-button" bindtap="openSearch" aria-label="搜索记录"><image class="icon small" src="/assets/search.svg" /></button><button class="today-button" bindtap="today"><image class="icon small" src="/assets/calendar.svg" />今天</button></view>
    <view class="quick-row"><button wx:for="{{quick}}" wx:key="kind" class="quick quick-{{item.kind}} {{item.kind === 'study' && timer ? 'quick-running' : ''}}" bindtap="add" data-kind="{{item.kind}}"><image class="icon" src="/assets/{{item.icon}}.svg" /><text>{{item.label}}</text><text wx:if="{{item.kind === 'study' && timer}}" class="quick-status"></text></button></view>
    <view class="home-style-row"><view class="segmented"><text class="{{homeStyle === 'events' ? 'active' : ''}}" data-style="events" bindtap="switchHomeStyle">事件</text><text class="{{homeStyle === 'axis' ? 'active' : ''}}" data-style="axis" bindtap="switchHomeStyle">时间轴</text></view></view>
    <block wx:if="{{homeStyle === 'axis'}}">
    <view class="column-labels {{view === 'split' ? '' : 'labels-hidden'}}"><text>{{meLabel}}</text><text>{{partnerLabel}}</text></view>
    <scroll-view scroll-y class="timeline-scroll" scroll-top="{{scrollTop}}" scroll-with-animation bindscroll="onScroll" enhanced show-scrollbar="{{false}}">
      <view class="timeline-canvas">
        <view class="timeline-ground tints-{{view}}"><view class="ground-self"></view><view class="ground-partner"></view></view>
        <view wx:for="{{hours}}" wx:key="label" class="hour-row" style="top:{{item.top}}rpx"><text>{{item.label}}</text><view class="hour-line"></view></view>
        <view class="event-area view-{{view}} {{view === 'split' ? 'split' : ''}}">
          <view class="event-column mine-column">
            <view wx:for="{{mine}}" wx:key="_id" class="event mine {{focusedId === item._id ? 'just-saved' : ''}} {{item.end ? 'duration-event' : 'point-event'}} {{item.height < 96 ? 'short-event' : ''}}" style="top:{{item.top}}rpx;height:{{item.height}}rpx;left:{{item.left}}%;width:{{item.width}}%">
              <view class="event-inner"><view class="event-copy"><text class="event-time">{{item.timeLabel}}</text><view class="event-title"><image wx:if="{{view !== 'split'}}" class="icon small" src="/assets/{{item.icon}}.svg" /><text>{{item.title}}</text><image wx:if="{{item.private}}" class="lock" src="/assets/lock.svg" /></view><text wx:if="{{item.height > 155}}" class="event-note">{{item.duration}}</text></view><image wx:if="{{item.photo && view !== 'split'}}" class="event-photo" src="{{item.photo}}" mode="aspectFill" /></view>
            </view>
          </view>
          <view class="event-column partner-column">
            <view wx:for="{{theirs}}" wx:key="_id" class="event sand {{focusedId === item._id ? 'just-saved' : ''}} {{item.end ? 'duration-event' : 'point-event'}} {{item.height < 96 ? 'short-event' : ''}}" style="top:{{item.top}}rpx;height:{{item.height}}rpx;left:{{item.left}}%;width:{{item.width}}%">
              <view class="event-inner"><view class="event-copy"><text class="event-time">{{item.timeLabel}}</text><view class="event-title"><image wx:if="{{view !== 'split'}}" class="icon small" src="/assets/{{item.icon}}.svg" /><text>{{item.title}}</text></view><text wx:if="{{item.height > 155}}" class="event-note">{{item.duration}}</text></view><image wx:if="{{item.photo && view !== 'split'}}" class="event-photo" src="{{item.photo}}" mode="aspectFill" /></view>
            </view>
          </view>
          <view class="timeline-divider" style="left:{{view === 'me' ? 100 : view === 'partner' ? 0 : 50}}%"></view>
        </view>
        <view wx:if="{{isToday}}" class="now-line" style="top:{{nowTop}}rpx"><text class="now-dot"></text></view>
      </view>
    </scroll-view>
    </block>
    <scroll-view wx:else scroll-y class="timeline-scroll compact-scroll" scroll-top="{{scrollTop}}" scroll-into-view="{{eventAnchor}}" scroll-with-animation bindscroll="onScroll" enhanced show-scrollbar="{{false}}">
      <view class="compact-events">
        <view wx:if="{{events.length === 0 && !busy}}" class="event-list-empty"><image src="/assets/leaf.svg"/><text>当天暂无记录</text></view>
        <view wx:for="{{events}}" wx:key="_id" id="event-{{item._id}}" class="event-card {{item.own ? 'self-card' : 'partner-card'}} {{focusedId === item._id ? 'just-saved' : ''}}">
          <view class="event-card-head"><view class="event-member"><image class="event-member-avatar" src="{{item.ownerAvatar}}" mode="aspectFill"/><text>{{item.ownerName}}</text></view><text class="event-card-time">{{item.timeLabel}}</text></view>
          <view class="event-card-title"><image class="icon small" src="/assets/{{item.icon}}.svg"/><text class="event-card-name">{{item.title}}</text><text wx:if="{{item.duration}}" class="event-duration">{{item.duration}}</text><image wx:if="{{item.private}}" class="lock" src="/assets/lock.svg"/></view>
          <text wx:if="{{item.merchant}}" class="event-extra">{{item.merchant}}</text><text wx:if="{{item.kind === 'body' && item.category === '经期'}}" class="event-extra">流量 {{item.flow}} · {{item.end ? '已结束' : '持续中'}}</text>
          <text wx:if="{{item.note}}" class="card-note {{item.noteOpen ? '' : 'note-clamped'}}">{{item.note}}</text><button wx:if="{{item.noteExpandable}}" class="card-link" data-id="{{item._id}}" bindtap="toggleNote">{{item.noteOpen ? '收起备注' : '展开备注'}}</button>
          <view wx:if="{{item.photos.length}}" class="card-photos photos-{{item.photos.length}}"><view wx:for="{{item.thumbnails}}" wx:for-item="photo" wx:key="file" data-id="{{item._id}}" data-file="{{photo.file}}" bindtap="previewEventPhotos"><image wx:if="{{photo.url}}" src="{{photo.url}}" mode="aspectFill" lazy-load/><text wx:else>加载照片</text></view></view>
          <view wx:if="{{item.commentCount}}" class="comment-tags"><view wx:for="{{item.commentTags}}" wx:for-item="comment" wx:key="id" class="comment-tag" data-id="{{item._id}}" data-comment="{{comment.id}}" bindtap="replyComment" hover-class="tap"><view class="comment-line"><text class="comment-author">{{comment.name}}</text><text wx:if="{{comment.replyName}}" class="comment-reply-to">回复 {{comment.replyName}}</text><text class="comment-reply-action">回复</text></view><text class="comment-body">{{comment.text}}</text></view></view>
          <view class="card-actions"><button wx:if="{{item.commentCount > 2}}" class="card-link" data-id="{{item._id}}" bindtap="toggleComments">{{item.commentsOpen ? '收起评论' : '全部 ' + item.commentCount + ' 条评论'}}</button><button class="card-link" data-id="{{item._id}}" bindtap="openComment">评论</button><button wx:if="{{item.own}}" class="card-link" data-id="{{item._id}}" bindtap="recordTap">编辑</button></view>
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{homeStyle === 'axis' && empty && !busy}}" class="timeline-empty viewport-empty"><image src="/assets/leaf.svg" /><text>{{homeStyle === 'axis' && view === 'partner' ? '暂无对方记录' : '当天暂无记录'}}</text></view>
    <button class="fab" bindtap="add" aria-label="添加我的记录">＋</button>
  </view>
  <scroll-view wx:if="{{tab === 'calendar' || tab === 'stats'}}" scroll-y class="content-scroll calendar-page">
    <view class="scene-heading"><image class="scene-image" src="/assets/scene-{{tab === 'stats' ? 'stats' : 'calendar'}}.svg" mode="scaleToFill"/><view class="section-heading calendar-heading"><text class="page-title">{{tab === 'stats' ? statsLabel + '统计' : '日历'}}</text><view wx:if="{{tab === 'calendar'}}" class="segmented"><text class="{{calendarMode === 'month' ? 'active' : ''}}" bindtap="calendarFilter" data-field="calendarMode" data-value="month">月</text><text class="{{calendarMode === 'week' ? 'active' : ''}}" bindtap="calendarFilter" data-field="calendarMode" data-value="week">周</text></view></view>
    </view><view class="calendar-toolbar"><button class="arrow" bindtap="calendarPrevious" aria-label="上一页">‹</button><picker mode="date" value="{{date}}" bindchange="pickDate"><text class="section-title">{{tab === 'stats' ? (periodView ? date : statsVisual.rangeLabel) : monthLabel}} ▾</text></picker><button class="arrow" bindtap="calendarNext" aria-label="下一页">›</button><button wx:if="{{tab === 'calendar'}}" class="today-button" bindtap="toggleCalendarFilters">筛选{{calendarOwner !== 'all' || calendarKind !== 'all' ? ' ·' : ''}}</button><button class="today-button" bindtap="today">今天</button></view>
    <block wx:if="{{tab === 'calendar'}}">
    <view wx:if="{{calendarFiltersOpen}}" class="calendar-filters"><view class="feed-filters"><text class="filter {{calendarOwner === 'all' ? 'active' : ''}}" bindtap="calendarFilter" data-field="calendarOwner" data-value="all">全部成员</text><text class="filter {{calendarOwner === 'me' ? 'active' : ''}}" bindtap="calendarFilter" data-field="calendarOwner" data-value="me">{{meLabel}}</text><text class="filter {{calendarOwner === 'partner' ? 'active' : ''}}" bindtap="calendarFilter" data-field="calendarOwner" data-value="partner">{{partnerLabel}}</text></view><view class="feed-filters"><text class="filter {{calendarKind === 'all' ? 'active' : ''}}" bindtap="calendarFilter" data-field="calendarKind" data-value="all">全部类型</text><text wx:for="{{quick}}" wx:key="kind" class="filter {{calendarKind === item.kind ? 'active' : ''}}" bindtap="calendarFilter" data-field="calendarKind" data-value="{{item.kind}}">{{item.label}}</text></view></view>
    <view class="calendar-grid" bindtouchstart="calendarTouchStart" bindtouchend="calendarTouchEnd"><text wx:for="{{weekLabels}}" wx:key="*this" class="weekday">{{item}}</text><view wx:for="{{monthCells}}" wx:key="date" class="calendar-cell {{item.selected ? 'chosen' : ''}} {{item.today ? 'is-today' : ''}} {{item.outside ? 'outside' : ''}}" bindtap="chooseDay" data-date="{{item.date}}" data-active="{{item.active}}"><text class="calendar-day {{item.period ? 'period-day' : ''}} {{item.weekend ? 'weekend' : ''}}">{{item.day}}</text><view wx:if="{{item.special.length}}" class="calendar-special"><view wx:for="{{item.special}}" wx:for-item="special" wx:key="category" class="special-symbol"><text>{{special.symbol}}</text><view class="special-owners"><text wx:if="{{special.mine}}" class="self-dot"></text><text wx:if="{{special.theirs}}" class="partner-dot"></text></view></view></view><view wx:else class="calendar-dots"><text wx:if="{{item.mine || item.periodMine}}" class="calendar-dot self-dot"></text><text wx:if="{{item.theirs || item.periodTheirs}}" class="calendar-dot partner-dot"></text></view></view></view>
    <view class="calendar-agenda"><view class="panel-head"><view><text class="section-title">{{dateLabel}}</text><text class="muted">{{dayCount}} 条 · 学习 {{dayStudy}}{{dayPhotos ? ' · 照片 ' + dayPhotos : ''}}</text></view><button class="agenda-add" bindtap="openCalendarAdd" aria-label="新增当天记录">＋</button></view>
      <view wx:for="{{agendaPreview}}" wx:key="_id" class="agenda-record kind-{{item.kind}}" bindtap="recordTap" data-id="{{item._id}}" hover-class="tap"><view class="agenda-time"><text>{{item.timeLabel}}</text><text class="muted">{{item.ownerName}}{{item.duration ? ' · ' + item.duration : ''}}</text></view><view class="agenda-main"><image class="icon" src="/assets/{{item.icon}}.svg"/><text class="agenda-title">{{item.title}}</text><image wx:if="{{item.private}}" class="lock" src="/assets/lock.svg"/><text class="chevron">›</text></view></view>
      <button wx:if="{{dayCount > 3}}" class="agenda-more" bindtap="toggleAgenda">{{agendaExpanded ? '收起' : '查看其余 ' + (dayCount - 3) + ' 条'}}</button>
      <text wx:if="{{!dayCount}}" class="empty-text">{{busy ? '加载中…' : '当天暂无记录'}}</text>
    </view>
    </block>
    <view wx:if="{{tab === 'stats'}}" class="stats-dashboard">
      <view class="stats-kinds"><button wx:for="{{quick}}" wx:key="kind" class="{{statsKind === item.kind ? 'selected' : ''}}" data-kind="{{item.kind}}" bindtap="statsKind">{{item.label}}</button></view>
      <view class="stats-controls"><view wx:if="{{!periodView}}" class="segmented"><text wx:for="{{statCards}}" wx:key="scope" class="{{statScope === item.scope ? 'active' : ''}}" bindtap="scope" data-scope="{{item.scope}}">{{item.scope === 'day' ? '日' : item.scope === 'week' ? '周' : '月'}}</text></view><text wx:else class="stats-window">近 180 天</text><view class="stats-members"><text class="{{statsOwner === 'me' ? 'selected' : ''}}" data-owner="me" bindtap="statsMember">{{meLabel}}</text><text wx:if="{{partner}}" class="{{statsOwner === 'partner' ? 'selected' : ''}}" data-owner="partner" bindtap="statsMember">{{partnerLabel}}</text><text wx:if="{{partner}}" class="{{statsOwner === 'all' ? 'selected' : ''}}" data-owner="all" bindtap="statsMember">{{periodView ? '分别查看' : '合计'}}</text></view></view>
      <view wx:if="{{statsKind === 'body'}}" class="stats-body"><button wx:for="{{bodyCategories}}" wx:key="value" class="{{bodyCategory === item.value ? 'selected' : ''}}" data-category="{{item.value}}" bindtap="bodyStats">{{item.label}}</button></view>
      <view wx:if="{{periodView}}" class="period-dashboard">
        <text wx:if="{{periodBusy}}" class="empty-text">正在读取历史…</text>
        <view wx:elif="{{periodError}}" class="stats-card"><text>{{periodError}}</text><button class="stats-expand" bindtap="loadPeriodStats">重试</button></view>
        <block wx:else>
          <view wx:for="{{periodStats.groups}}" wx:key="id" wx:for-item="group" class="period-person">
            <view class="stats-hero period-hero"><view class="stats-card-head"><text>🩸 {{group.name}}</text><text>{{group.count}} 次记录</text></view><text class="period-status">{{group.status}}</text><text class="period-latest">最近开始 {{group.latest}}</text><view class="stats-metrics period-metrics"><view><text>{{group.cycleAverage}}</text><text>平均周期</text><text>{{group.cycleCount}} 个开始间隔</text></view><view><text>{{group.durationAverage}}</text><text>平均持续</text><text>{{group.completedCount}} 次已结束</text></view></view></view>
            <block wx:if="{{group.count}}">
              <view class="stats-card"><view class="stats-card-head"><text>周期变化</text><text>相邻开始日期</text></view><text wx:if="{{!group.cycles.length}}" class="period-empty">至少两个不同的开始日期后显示</text><view wx:for="{{group.cycles}}" wx:key="date" wx:for-item="cycle" class="stats-rank"><view class="stats-rank-line"><text>{{cycle.previous}} → {{cycle.date}}</text><text>{{cycle.days}}天</text></view><view class="stats-track"><view style="width:{{cycle.width}}%"></view></view></view></view>
              <view class="stats-card"><view class="stats-card-head"><text>流量分布</text><text>按每次记录</text></view><view wx:for="{{group.flow}}" wx:key="name" wx:for-item="flow" class="period-flow"><text>{{flow.name}}</text><view class="stats-track"><view style="width:{{flow.width}}%"></view></view><text>{{flow.count}}次</text></view></view>
              <view class="stats-card"><view class="stats-card-head"><text>历次 🩸</text><text>点开查看详情</text></view><view wx:for="{{group.history}}" wx:key="id" wx:for-item="entry" class="period-entry" data-id="{{entry.id}}" bindtap="recordTap"><view><text>{{entry.start}} → {{entry.end}}</text><text>{{entry.open ? '已持续' : '持续'}} {{entry.duration}} · 流量 {{entry.flow}}</text></view><text>›</text></view></view>
            </block>
          </view>
        </block>
      </view>
      <block wx:else>
      <view class="stats-hero"><text class="stats-eyebrow">{{statsVisual.rangeLabel}}</text><text class="stats-hero-label">{{statsVisual.headlineLabel}}</text><text class="stats-hero-value">{{statsVisual.headline}}</text><text class="stats-insight">{{statsVisual.insight}}</text><view class="stats-metrics"><view wx:for="{{statsVisual.metrics}}" wx:key="label"><text>{{item.value}}</text><text>{{item.label}}</text></view></view></view>
      <view wx:if="{{!statsVisual.hasData}}" class="stats-empty"><image src="/assets/leaf.svg"/><text>还没有{{statsVisual.label}}数据</text><text>换个日期或成员查看</text></view>
      <block wx:else>
        <view wx:if="{{statScope !== 'day'}}" class="stats-card"><view class="stats-card-head"><text>每日{{statsVisual.unit}}</text><text>{{statsKind === 'sleep' ? '按自然日累计' : '点柱子看数值'}}</text></view><view class="stats-day-value"><text>{{statsVisual.picked.shortDate}}</text><text>{{statsVisual.picked.valueLabel}}</text></view><scroll-view scroll-x class="stats-trend-scroll" show-scrollbar="{{false}}"><view class="stats-bars"><view wx:for="{{statsVisual.trend}}" wx:key="date" class="stats-bar-day {{item.chosen ? 'chosen' : ''}} {{item.future ? 'future' : ''}}" data-date="{{item.date}}" bindtap="selectStatsDay" aria-label="{{item.shortDate + ' ' + item.valueLabel}}"><view class="stats-bar-track"><view style="height:{{item.height}}%"></view></view><text>{{item.label}}</text><text class="stats-bar-zero" wx:if="{{!item.ms}}">{{item.future ? '未到' : '—'}}</text></view></view></scroll-view><text wx:if="{{statScope === 'month'}}" class="stats-footnote">左右滑动查看整月</text></view>
        <view wx:if="{{statsKind === 'meal'}}" class="stats-card"><view class="stats-card-head"><text>最常吃的商家</text><text>按次数排序</text></view><view wx:for="{{studyReport.merchants}}" wx:key="name" class="stats-rank"><view class="stats-rank-line"><text>{{item.name}}</text><text>{{item.count}}次</text></view><view class="stats-track"><view style="width:{{item.percent}}%"></view></view></view></view>
        <view wx:if="{{statsKind !== 'body'}}" class="stats-card"><view class="stats-card-head"><text>{{statsVisual.rankTitle}}</text><text>{{statsVisual.unit}} / 占比</text></view><view wx:for="{{statsVisual.ranked}}" wx:key="name" class="stats-rank"><view class="stats-rank-line"><text>{{item.name}}</text><text>{{item.label}}<text class="stats-percent"> · {{item.percent}}%</text></text></view><view class="stats-track"><view style="width:{{item.width}}%"></view></view></view></view>
        <view class="stats-card"><view class="stats-card-head"><text>{{studyReport.duration ? '时间集中在哪' : '常发生在几点'}}</text><text>{{statsVisual.unit}}</text></view><view wx:for="{{statsVisual.slots}}" wx:key="name" class="stats-slot"><view><text>{{item.name}}</text><text>{{item.range}}</text></view><view class="stats-track"><view style="width:{{item.width}}%"></view></view><text>{{item.label}}</text></view><button class="stats-expand" bindtap="toggleStatsHeat">{{statsHeatExpanded ? '收起小时分布 ↑' : '展开小时分布 ↓'}}</button><view wx:if="{{statsHeatExpanded}}" class="stats-heat"><view class="heatmap-head"><text></text><text wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text></view><view wx:for="{{studyReport.heatmap}}" wx:key="hour" class="heatmap-row"><text>{{item.label}}</text><view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key" class="heat-cell heat-{{cell.level}}" data-label="{{cell.label}}" bindtap="heatTap" aria-label="{{cell.label}}"></view></view><text class="heat-detail">{{heatDetail || '点击色块查看数值'}}</text><view class="heat-legend"><text>少</text><view wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="heat-cell heat-{{item}}"></view><text>多</text></view></view></view>
        <view wx:if="{{statsOwner === 'all'}}" class="stats-card"><view class="stats-card-head"><text>成员明细</text></view><view wx:for="{{studyReport.members}}" wx:key="id" class="stats-rank-line"><text>{{item.name}}</text><text>{{item.label}}</text></view></view>
      </block>
      </block>
    </view><view class="bottom-space"></view>
  </scroll-view>
  <scroll-view wx:elif="{{tab === 'us' || tab === 'me'}}" scroll-y class="content-scroll"><view class="scene-heading"><image class="scene-image" src="/assets/scene-us.svg" mode="scaleToFill"/><view class="section-heading"><text class="page-title">我们</text></view></view>
    <view class="panel profile-panel" bindtap="editProfile"><image class="large-avatar" src="{{me.avatarUrl || '/assets/avatar-me.svg'}}" /><view><text class="section-title">{{meLabel}}</text><text class="muted">{{me.city.name}}{{me.status ? ' · ' + me.status : ''}}</text></view><text class="chevron">›</text></view>
    <view class="panel"><view class="panel-head"><text class="section-title">数据与连接</text><text class="badge">{{mode === 'demo' ? '本机演示' : '云端模式'}}</text></view><button wx:if="{{mode === 'demo'}}" class="primary" loading="{{busy}}" bindtap="connect">连接云端</button><button wx:else class="secondary" bindtap="demoMode">演示模式</button><view class="settings-row" bindtap="refresh"><text>刷新记录</text><text>↻</text></view><view class="settings-row" bindtap="exportData"><view><text>导出 {{exportYear}} 年本人记录</text></view><text>↗</text></view><view class="settings-row" bindtap="cleanup"><text>重试清理已删除照片</text><text>›</text></view></view>
    <view class="panel"><text class="section-title">微信动态通知</text><button class="secondary" bindtap="subscribeNotifications">{{notification.templateId ? '订阅下一条通知' : '通知待配置'}}</button></view>
    <view class="panel"><view class="panel-head"><text class="section-title">{{partner ? '已绑定' : '邀请成员'}}</text><text class="badge">{{mode === 'demo' ? '演示空间' : '双人空间'}}</text></view><text wx:if="{{partner}}" class="body-text">{{meLabel}} · {{me.city.name}} / {{partnerLabel}} · {{partner.city.name}}</text><view wx:if="{{partner}}" class="status-card"><text>{{partnerLabel}}</text><text>{{partner.status || '未设置状态'}}</text></view><button wx:if="{{!partner}}" class="primary" bindtap="invite">生成邀请口令</button><view wx:if="{{invite}}" class="invite-box"><text selectable>{{invite}}</text><button class="secondary" bindtap="copyInvite">复制口令</button></view><view wx:if="{{!partner}}" class="join-form"><input placeholder="输入邀请口令" value="{{joinCode}}" bindinput="joinInput" maxlength="200" /><button class="secondary" bindtap="join">加入空间</button></view><button wx:if="{{partner && mode === 'cloud'}}" class="text-button danger" bindtap="unlink">解除绑定</button></view>
<view class="bottom-space"></view></scroll-view>
  <view wx:if="{{searchOpen}}" class="feed-page search-overlay">
    <view class="section-heading"><text class="page-title">搜索记录</text><button class="search-close arrow" bindtap="closeSearch" aria-label="关闭搜索">×</button><text class="muted">{{feedCount}} 条记录</text></view>
    <view class="feed-controls">
      <view class="panel-head"><button class="arrow" bindtap="monthPrevious" aria-label="上个月">‹</button><picker mode="date" fields="month" value="{{date}}" bindchange="pickFeedMonth"><text class="section-title">{{monthLabel}} ▾</text></picker><button class="arrow" bindtap="monthNext" aria-label="下个月">›</button><button class="today-button" bindtap="today">本月</button></view>
      <input class="feed-search" placeholder="搜索记录" value="{{feedQuery}}" bindinput="feedSearch" maxlength="100" confirm-type="search" />
      <view class="feed-filters"><text class="filter {{feedOwner === 'all' ? 'active' : ''}}" bindtap="feedFilter" data-field="feedOwner" data-value="all">全部成员</text><text class="filter {{feedOwner === 'me' ? 'active' : ''}}" bindtap="feedFilter" data-field="feedOwner" data-value="me">{{meLabel}}</text><text class="filter {{feedOwner === 'partner' ? 'active' : ''}}" bindtap="feedFilter" data-field="feedOwner" data-value="partner">{{partnerLabel}}</text></view>
      <view class="feed-filters"><text class="filter {{feedKind === 'all' ? 'active' : ''}}" bindtap="feedFilter" data-field="feedKind" data-value="all">全部类型</text><text wx:for="{{quick}}" wx:key="kind" class="filter {{feedKind === item.kind ? 'active' : ''}}" bindtap="feedFilter" data-field="feedKind" data-value="{{item.kind}}">{{item.label}}</text></view>
    </view>
    <scroll-view scroll-y class="content-scroll" scroll-top="{{feedScroll}}" bindscroll="feedScrolled" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{feedGroups}}" wx:key="date" wx:for-item="group" class="feed-group"><view class="feed-date" bindtap="openDay" data-date="{{group.date}}"><text>{{group.date}}</text><text class="muted">{{group.records.length}} 条 ›</text></view>
        <view wx:for="{{group.records}}" wx:key="_id" class="feed-record" bindtap="recordTap" data-id="{{item._id}}" hover-class="tap"><view class="feed-dot"></view><view class="feed-record-head"><image class="icon" src="/assets/{{item.icon}}.svg"/><text class="section-title">{{item.title}}</text><image wx:if="{{item.private}}" class="lock" src="/assets/lock.svg"/><text class="chevron">›</text></view><text class="muted">{{item.ownerName}} · {{item.timeLabel}}</text><text wx:if="{{item.continued}}" class="muted">上月开始 · 持续至本月</text><text wx:if="{{item.duration}}" class="muted">本月时长 {{item.duration}}</text><text wx:if="{{item.note}}" class="feed-note">{{item.note}}</text><image wx:if="{{item.photo}}" class="feed-photo" src="{{item.photo}}" mode="aspectFill" lazy-load /></view>
      </view>
      <view wx:if="{{!feedCount}}" class="feed-empty"><text>{{busy ? '正在加载记录…' : error ? '加载失败，请点击顶部重试' : '暂无符合条件的记录'}}</text><button class="secondary" bindtap="resetFeed">清除筛选</button><button class="primary" bindtap="add">添加记录</button></view><view class="bottom-space"></view>
    </scroll-view>
  </view>
  <movable-area wx:if="{{timer && !focusOpen && !studyOpen && !editorRequest && !profileOpen}}" class="timer-float-area"><movable-view direction="all" x="{{floatX}}" y="{{floatY}}" class="timer-float" bindchange="floatMoved"><view class="timer-details" bindtap="openStudy"><text class="timer-title">{{timer.category}} · {{timer.restUntil ? (timer.restCompleted ? '休息结束' : '休息中') : timer.completed ? '已完成' : timer.runningSince ? '专注中' : '已暂停'}}</text><text class="timer-clock">{{timer.restUntil ? restRemaining : timer.goalMs ? remaining : elapsed}}</text></view><view class="float-controls"><button class="timer-pause" bindtap="pauseTimer" disabled="{{timerSaving || timer.completed}}">{{timer.runningSince ? '暂停' : '继续'}}</button><button class="timer-finish" bindtap="finishTimer" disabled="{{timerSaving}}">结束</button></view></movable-view></movable-area>
  <view wx:if="{{focusOpen && timer}}" class="focus-page"><image class="focus-scenery" src="/assets/scene-stats.svg" mode="scaleToFill"/><view class="panel-head"><text class="section-title">{{timer.goalMs ? '番茄专注' : '自由计时'}}</text><button class="secondary" bindtap="minimizeFocus">缩小 ↘</button></view><view class="focus-content"><text class="focus-subject">{{timer.category}}</text><view class="focus-ring" style="background:conic-gradient(#789476 {{focusProgress}}%, #e5ebdc 0)"><view><text class="focus-clock">{{timer.restUntil ? restRemaining : timer.goalMs ? remaining : elapsed}}</text><text class="muted">{{timer.restUntil ? (timer.restCompleted ? '休息结束' : '休息中') : timer.completed ? '本轮完成' : timer.runningSince ? '正在专注' : '已暂停'}}</text></view></view><text class="muted">有效学习 {{elapsed}}</text><view wx:if="{{timer.completed}}" class="round-actions"><button wx:if="{{!timer.restUntil}}" class="secondary" bindtap="startRest" disabled="{{timerSaving}}">休息 5 分钟</button><button class="primary" bindtap="nextRound" disabled="{{timerSaving}}">保存并开始下一轮</button></view><view class="study-controls"><button class="secondary" bindtap="pauseTimer" disabled="{{timerSaving || timer.completed}}">{{timer.runningSince ? '暂停' : '继续'}}</button><button class="primary" bindtap="finishTimer" loading="{{timerSaving}}" disabled="{{timerSaving}}">结束并保存</button></view></view></view>
  <view class="tabbar"><view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'active' : ''}}" data-tab="{{item.key}}" bindtap="changeTab"><image src="/assets/{{item.icon}}.svg" /><text>{{item.label}}</text></view></view>
  <view wx:if="{{profileOpen}}" class="modal-mask profile-mask" bindtap="closeProfile"><view class="sheet profile-sheet" catchtap="noop"><view class="panel-head"><text class="section-title">个人资料</text><button class="arrow" bindtap="closeProfile">×</button></view><button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="avatarChoose"><image class="large-avatar" src="{{profile.avatarUrl || '/assets/avatar-me.svg'}}" /><text>更换头像</text></button><view class="field"><text>昵称</text><input type="nickname" value="{{profile.name}}" maxlength="16" data-field="name" bindinput="profileField" /></view><view class="field"><text>城市</text><picker range="{{cities}}" value="{{cityIndex}}" bindchange="cityChange">{{cities[cityIndex]}}　›</picker></view><view class="field"><text>今日状态</text><input value="{{profile.status}}" maxlength="30" data-field="status" bindinput="profileField" placeholder="输入状态（选填）" /></view><button class="primary profile-save" bindtap="saveProfile">保存资料</button></view></view>
  <view wx:if="{{studyOpen}}" class="study-mask" bindtap="closeStudy"><view class="study-sheet" catchtap="noop"><view class="panel-head"><text class="section-title">学习计时</text><button class="arrow" bindtap="closeStudy" aria-label="关闭学习计时">×</button></view>
    <view wx:if="{{!timer}}" class="timer-setup"><view class="segmented"><text class="{{timerMode === 'pomodoro' ? 'active' : ''}}" data-mode="pomodoro" bindtap="chooseTimerMode">番茄专注</text><text class="{{timerMode === 'free' ? 'active' : ''}}" data-mode="free" bindtap="chooseTimerMode">自由计时</text></view><view wx:if="{{timerMode === 'pomodoro'}}" class="focus-presets"><button wx:for="{{[15,25,45,60]}}" wx:key="*this" class="{{focusMinutes == item ? 'selected' : ''}}" data-minutes="{{item}}" bindtap="focusPreset">{{item}} 分钟</button></view><view wx:if="{{timerMode === 'pomodoro'}}" class="focus-duration"><text>专注时长</text><input type="number" value="{{focusMinutes}}" bindinput="focusInput" maxlength="3"/><text>分钟</text></view></view>
    <view wx:if="{{!timer}}" class="study-subject-grid"><button wx:for="{{studyCategories}}" wx:key="*this" class="study-subject {{studyCategory === item ? 'selected' : ''}}" bindtap="chooseStudy" data-subject="{{item}}">{{item}}</button></view>
    <view wx:else class="study-live"><text>{{timer.category}}</text><text class="study-live-clock">{{elapsed}}</text><text class="muted">{{timer.runningSince ? '学习中' : '已暂停'}}</text></view>
    <button wx:if="{{!timer}}" class="primary study-start" bindtap="startTimer">开始计时</button><view wx:else class="study-controls"><button class="secondary" bindtap="pauseTimer" disabled="{{timerSaving}}">{{timer.runningSince ? '暂停' : '继续'}}</button><button class="primary" bindtap="finishTimer" loading="{{timerSaving}}" disabled="{{timerSaving}}">结束并保存</button></view><button wx:if="{{!timer}}" class="text-button" bindtap="manualStudy">补记学习</button>
  </view></view>
  <view wx:if="{{calendarAddOpen}}" class="study-mask" bindtap="closeCalendarAdd"><view class="study-sheet" catchtap="noop"><view class="panel-head"><text class="section-title">补记 · {{date}}</text><button class="arrow" bindtap="closeCalendarAdd">×</button></view><view class="calendar-add-grid"><button wx:for="{{quick}}" wx:key="kind" class="study-subject" data-kind="{{item.kind}}" bindtap="add"><image class="icon" src="/assets/{{item.icon}}.svg"/>{{item.label}}</button></view></view></view>
  <view wx:if="{{commentId}}" class="study-mask" bindtap="closeComment"><view class="study-sheet" catchtap="noop"><view class="panel-head"><text class="section-title">{{replyTo ? '回复 ' + replyName : '评论'}}</text><button class="arrow" bindtap="closeComment">×</button></view><view wx:if="{{replyTo}}" class="reply-quote">{{replyText}}</view><textarea class="comment-input" value="{{commentText}}" maxlength="40" bindinput="commentInput" placeholder="写评论"/><view class="comment-counter">{{commentText.length}} / 40</view><button class="primary" bindtap="sendComment" loading="{{commentBusy}}" disabled="{{commentBusy || !commentText.length}}">发送评论</button></view></view>
  <page-container show="{{backGuard}}" overlay="{{false}}" duration="{{0}}" close-on-slide-down="{{false}}" custom-style="height:0;background:transparent;" bindafterleave="nativeBack" />
  <record-editor id="recordEditor" request="{{editorRequest}}" bind:close="editorClosed" />
</view>



/* Open layout: a single canvas, typography, spacing and quiet dividers. */
.app-shell,.today-page,.content-scroll,.feed-page,.search-overlay,.focus-page{background:#fafaf7}
.today-page{padding:12rpx 30rpx 0}
.couple-card{background:transparent;border-radius:0;overflow:visible;min-height:0;padding:6rpx 0 20rpx;border-bottom:1rpx solid #e8eae3}
.profile-half.self,.profile-half.partner{background:transparent;padding:10rpx 0;gap:14rpx}.profile-half.partner{padding-left:22rpx}
.avatar{width:60rpx;height:60rpx;border:0;padding:0}.selected.self .avatar,.selected.partner .avatar{border-color:transparent}
.name{font-size:26rpx;color:#3b4d41;font-weight:500}.partner .name{color:#8c785e}.weather{color:#879085;font-size:18rpx}
.date-row{padding:22rpx 0 12rpx}.date-title{font-size:31rpx;letter-spacing:1rpx;color:#343f37;font-weight:500}
.quick-row{gap:8rpx;margin:0;padding:10rpx 0 22rpx;border-bottom:1rpx solid #e8eae3}
.quick{display:flex;flex:1;align-items:center;justify-content:center;gap:8rpx;background:transparent!important;border:0!important;border-radius:0!important;padding:8rpx 0!important;font-size:23rpx!important;color:#637563}.quick .icon{width:27rpx;height:27rpx;opacity:.85}
.home-style-row{padding:14rpx 0 8rpx}.segmented,.home-style-row .segmented{background:transparent;border-radius:0;padding:0;gap:18rpx;color:#899287}.segmented text,.home-style-row .segmented text{background:transparent;border-radius:0;padding:10rpx 3rpx;border-bottom:2rpx solid transparent}.segmented .active,.home-style-row .segmented .active{background:transparent;color:#405d49;border-bottom-color:#667e6b}
.compact-events{padding:0 0 140rpx}
.event-card,.event-card.partner-card{background:transparent;border:0;border-bottom:1rpx solid #e5e8e0;border-radius:0;box-shadow:none;padding:24rpx 0 20rpx;margin:0;overflow:visible}
.event-card:last-child{border-bottom:0}.event-card-head{min-height:34rpx;align-items:center}
.event-member,.partner-card .event-member{display:flex;align-items:center;gap:10rpx;background:transparent;padding:0;border-radius:0;max-width:50%;font-size:22rpx;color:#526d57;font-weight:400}.partner-card .event-member{color:#9b8060}
.event-member-avatar{width:32rpx;height:32rpx;border:0}.event-card-time{color:#939b91;font-size:21rpx;max-width:48%;white-space:normal;text-align:right}
.event-card-title{margin-top:16rpx;gap:12rpx;min-height:0}.event-card-title>.icon{width:27rpx;height:27rpx;opacity:.7}.event-card-name{font-size:31rpx;font-weight:500;line-height:1.5;color:#303e34;flex:1}
.event-duration,.partner-card .event-duration{background:transparent;border-radius:0;padding:0;font-size:21rpx;color:#818d7b;max-width:145rpx;white-space:normal;margin-left:auto}
.event-extra{font-size:21rpx;color:#8c9388;margin-top:6rpx}.card-note{margin-top:12rpx;color:#616c61;font-size:25rpx;line-height:1.8}
.card-link,.partner-card .card-link{color:#7d8a79!important;font-size:21rpx!important}.card-actions{border:0;margin-top:10rpx;padding:0;gap:28rpx}
.card-photos{margin-top:18rpx;gap:8rpx}.card-photos>view{border-radius:4rpx;background:#eceee7}
.comment-tags{display:block;margin:18rpx 0 0 0;border-left:2rpx solid #d9e0d3;padding:0 0 0 18rpx;background:transparent;border-radius:0}
.comment-tag{display:block;background:transparent;border:0;border-radius:0;padding:8rpx 0;max-width:100%;box-sizing:border-box;font-size:23rpx}
.comment-line{display:flex;align-items:center;gap:8rpx;font-size:21rpx}.comment-author,.partner-card .comment-author{margin:0;color:#647b60;font-weight:500}.comment-reply-to{color:#949a8f;font-size:20rpx}.comment-reply-action{margin-left:auto;color:#8e9a86;font-size:20rpx}.comment-body{display:block;margin-top:4rpx;color:#687260;line-height:1.65;overflow-wrap:anywhere}
.reply-quote{border-left:2rpx solid #cfd8c7;background:transparent;padding:6rpx 18rpx;margin-bottom:24rpx;color:#88907d;font-size:24rpx;line-height:1.6;overflow-wrap:anywhere}.comment-input{background:transparent;border-bottom:1rpx solid #dde2d5;border-radius:0;padding:16rpx 0;height:170rpx}.comment-counter{color:#939b8a}
.today-page>.fab{background:#536e57;color:#fff;border-radius:50%;box-shadow:none;width:78rpx!important;min-width:78rpx!important;height:78rpx;line-height:78rpx;font-size:43rpx;right:30rpx}
.tabbar{background:#fafaf7;border-top:1rpx solid #e4e8dd;box-shadow:none}.tabbar .tab.active{color:#45604a}.tabbar .tab{color:#929c89}
.panel,.calendar-agenda,.stats-card,.stats-hero,.feed-controls,.feed-record,.profile-panel{background:transparent;border:0;border-radius:0;box-shadow:none}
.panel{margin:0 30rpx;padding:32rpx 0;border-bottom:1rpx solid #e5e8de}.panel:last-child{border-bottom:0}.panel-head{gap:16rpx}.section-heading{padding:30rpx 30rpx 22rpx}.page-title{font-size:36rpx;font-weight:500}.section-title{font-weight:500}.badge{background:transparent;padding:0;border-radius:0;color:#89957e}
.status-card,.invite-box{background:transparent;border-radius:0;padding:18rpx 0}.settings-row{border-color:#e7ebdf;padding:25rpx 0}.profile-panel .large-avatar{width:76rpx;height:76rpx}.status-card{border-top:1rpx solid #e6eadf}
.calendar-grid{background:transparent;border:0;border-radius:0;box-shadow:none}.calendar-agenda{margin:22rpx 30rpx;padding:24rpx 0;border-top:1rpx solid #e5e8de}.agenda-record{border-color:#e7eade;background:transparent}.calendar-toolbar{padding-left:30rpx;padding-right:30rpx}.calendar-day{box-shadow:none}.calendar-cell.chosen .calendar-day{background:#667e60;color:#fff;box-shadow:none}.calendar-dot{box-shadow:none}.calendar-cell .period-day{box-shadow:none!important}
.stats-dashboard{padding:0 30rpx 28rpx}.stats-kinds{padding:0;margin:4rpx 0 24rpx;border-radius:0;background:transparent;border-bottom:1rpx solid #e5e8de;gap:16rpx}.stats-kinds button{border-radius:0!important;padding:15rpx 0!important;color:#8b9681;background:transparent!important}.stats-kinds button.selected{background:transparent!important;color:#435e47;box-shadow:none;border-bottom:2rpx solid #637d5e}
.stats-hero{padding:20rpx 0 28rpx;margin:0;border-bottom:1rpx solid #e3e8da}.stats-hero-value{font-weight:400;color:#344c38}.stats-metrics>view{background:transparent;border-radius:0}.stats-card{padding:28rpx 0;margin:0;border-bottom:1rpx solid #e4e9dc}.stats-card-head{color:#536849}.stats-card-head>text:first-child{font-weight:500}.stats-members>text{background:transparent;border-radius:0;padding:8rpx 4rpx}.stats-members>text.selected{background:transparent;color:#435d3f;border-bottom:1rpx solid #6a8061}.stats-members{gap:16rpx}.stats-body button{background:transparent!important;border-radius:0!important}.stats-body .selected{background:transparent!important;border-bottom:1rpx solid #728965}.stats-window{background:transparent;padding:0}.stats-track,.stats-bar-track{background:#edf0e6}.stats-empty{padding:45rpx 0}.period-entry{border-color:#e3e8d9}.stats-percent{color:#909b80}
.feed-controls{padding:10rpx 30rpx 22rpx}.feed-search{background:transparent;border:0;border-bottom:1rpx solid #dfe5d5;border-radius:0;padding-left:0}.filter{background:transparent;border-radius:0;padding:10rpx 3rpx;margin-right:16rpx}.filter.active{background:transparent;color:#496241;border-bottom:1rpx solid #6a825b}.feed-record{margin:0;padding:24rpx 0;border-bottom:1rpx solid #e4e9da}.feed-dot{display:none}.feed-group{padding:0 30rpx}.feed-date{padding:22rpx 0}.feed-record-head .section-title{font-size:28rpx}
.sheet,.study-sheet,.profile-sheet{background:#fafaf7;border-radius:18rpx 18rpx 0 0;box-shadow:none;padding-left:30rpx;padding-right:30rpx}.study-subject{background:transparent!important;border:0!important;border-bottom:1rpx solid #e1e7d7!important;border-radius:0!important;color:#788867!important}.study-subject.selected{background:transparent!important;color:#435f37!important;border-bottom-color:#6b885c!important}.focus-presets button{background:transparent;border-radius:0;border-bottom:1rpx solid #e2e8d6}.focus-presets button.selected{background:transparent;border-bottom-color:#708858}.focus-duration input{background:transparent;border-radius:0;border-bottom:1rpx solid #dde5cf}.focus-ring>view{background:#fafaf7}.focus-clock{font-weight:400}.timer-float{background:#fafaf7;border:1rpx solid #d9e2cc;border-radius:12rpx;box-shadow:none}
.ground-self{background:#f0f3ec}.ground-partner{background:#f4f1eb}.timeline-canvas .event{box-shadow:none;border-radius:3rpx}.timeline-canvas .hour-line{opacity:.6}

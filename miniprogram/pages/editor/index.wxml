<view class="editor">
  <view class="editor-heading"><image class="editor-scenery" src="/assets/scene-editor.svg" mode="scaleToFill"/><text class="heading">{{readOnly ? '记录详情' : editing ? '编辑记录' : '新增记录'}}</text><text wx:if="{{readOnly}}" class="muted">只读</text></view>
  <view wx:if="{{mode === 'demo'}}" class="notice">演示模式</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="form-panel"><text class="label">记录类型</text><view class="chips"><text wx:for="{{categories}}" wx:key="value" class="chip {{category === item.value ? 'selected' : ''}}" bindtap="categoryTap" data-category="{{item.value}}">{{item.label}}</text></view><view class="field"><text>标题</text><input value="{{title}}" placeholder="{{categoryLabel}}" maxlength="40" disabled="{{readOnly}}" data-field="title" bindinput="field" /></view></view>
  <view wx:if="{{kind === 'meal'}}" class="form-panel"><text class="label">商家标签</text><view class="field"><input value="{{merchant}}" placeholder="输入商家名称（选填）" maxlength="30" disabled="{{readOnly}}" data-field="merchant" bindinput="field" /><button wx:if="{{!readOnly}}" class="now-button" bindtap="rememberMerchant">存为常用</button></view><view class="chips"><view wx:for="{{merchants}}" wx:key="*this" class="chip {{merchant === item ? 'selected' : ''}}"><text bindtap="merchantTap" data-merchant="{{item}}">{{item}}</text><text wx:if="{{!readOnly}}" catchtap="forgetMerchant" data-merchant="{{item}}">　×</text></view></view></view>
  <view class="form-panel"><text class="label">{{isPeriod ? '🩸 时间' : '记录时间'}}</text><view class="field"><text>{{hasEnd || isPeriod ? '开始' : '时间'}}</text><view class="date-inputs"><button wx:if="{{!readOnly}}" class="now-button" bindtap="useNow">现在</button><picker mode="date" value="{{startDate}}" disabled="{{readOnly}}" data-field="startDate" bindchange="field">{{startDate}}</picker><picker mode="time" value="{{startTime}}" disabled="{{readOnly}}" data-field="startTime" bindchange="field">{{startTime}}</picker></view></view><view wx:if="{{isPeriod}}" class="field"><text>已结束</text><switch checked="{{periodEnded}}" disabled="{{readOnly}}" color="#789476" bindchange="periodSwitch" /></view><view wx:if="{{hasEnd}}" class="field"><text>结束</text><view class="date-inputs"><picker mode="date" value="{{endDate}}" disabled="{{readOnly}}" data-field="endDate" bindchange="field">{{endDate}}</picker><picker mode="time" value="{{endTime}}" disabled="{{readOnly}}" data-field="endTime" bindchange="field">{{endTime}}</picker></view></view><view wx:if="{{isPeriod}}" class="field"><text>本次流量</text><view class="chips"><text wx:for="{{flows}}" wx:key="*this" class="chip {{flow === item ? 'selected' : ''}}" data-flow="{{item}}" bindtap="flowTap">{{item}}</text></view></view><text wx:if="{{pausedRecord}}" class="muted">有效时长 {{effectiveDuration}}</text></view>
  <view class="form-panel"><text class="label">{{kind === 'body' ? '身体感受与备注' : '备注'}}</text><textarea value="{{note}}" placeholder="{{kind === 'meal' ? '填写食物及备注（选填）' : kind === 'body' ? '填写身体感受（选填）' : '填写备注（选填）'}}" maxlength="1000" disabled="{{readOnly}}" auto-height data-field="note" bindinput="field" /><view class="photos"><view wx:for="{{photos}}" wx:key="index" class="photo-cell"><image src="{{item.url}}" mode="aspectFill" bindtap="preview" data-index="{{index}}" /><button wx:if="{{!readOnly}}" class="photo-remove" bindtap="removePhoto" data-index="{{index}}">×</button><text wx:if="{{item.status === 'failed'}}" class="photo-state">上传待重试</text><button wx:if="{{readOnly || editing}}" class="photo-save" bindtap="savePhoto" data-index="{{index}}">另存相册</button></view><button wx:if="{{!readOnly && photos.length < 6}}" class="photo-add" bindtap="choosePhotos"><text>＋</text><text>拍照 / 相册</text></button></view></view>
  <view class="form-panel"><text class="label">谁可以看见</text><view class="visibility"><view class="visibility-option {{visibility === 'private' ? 'selected' : ''}}" data-value="private" bindtap="visible"><image class="icon" src="/assets/lock.svg" /><text>仅自己</text></view><view class="visibility-option {{visibility === 'shared' ? 'selected' : ''}}" data-value="shared" bindtap="visible"><image class="icon" src="/assets/users.svg" /><text>两人可见</text></view></view></view>
  <view wx:if="{{!readOnly}}" class="editor-actions"><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">{{busy ? '正在保存…' : '保存记录'}}</button><button wx:if="{{editing}}" class="text-button danger" bindtap="remove" disabled="{{busy}}">删除这条记录</button></view>
</view>

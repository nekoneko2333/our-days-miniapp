/* Shared open form layout. */
.editor{background:#fafaf7;padding:24rpx 30rpx calc(40rpx + env(safe-area-inset-bottom))}.form-panel{background:transparent;border:0;border-bottom:1rpx solid #e5e9dd;border-radius:0;padding:24rpx 0 30rpx;margin:0}.label{font-weight:500;color:#485a41}.chip{background:transparent;border-radius:0;padding:12rpx 5rpx;color:#8a967d;border-bottom:1rpx solid transparent}.chip.selected{background:transparent;color:#4d6942;border-bottom-color:#6c855d}.chips{gap:12rpx 22rpx}.date-inputs picker{background:transparent;border-radius:0;border-bottom:1rpx solid #e2e8d7;padding:9rpx 0}.visibility-option{border:0;border-bottom:1rpx solid #e1e7d4;border-radius:0;padding:20rpx 0}.visibility-option.selected{background:transparent;border-color:#728b62}.photo-cell>image{border-radius:4rpx}.photo-add{background:transparent!important;border-radius:4rpx!important}.now-button{background:transparent!important;border-radius:0!important}.notice{background:transparent;border-radius:0;padding:15rpx 0;color:#939b88}.editor-actions{padding:16rpx 0}.heading{font-weight:500}.error{border-radius:4rpx}

.editor{background:#faf7ef}.editor-heading{position:relative;isolation:isolate;min-height:180rpx;margin:-24rpx -30rpx 0;padding:30rpx;overflow:hidden}.editor-scenery{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:-1}.form-panel{border-color:#dfe5d7}.chip.selected{color:#4e7951;border-color:#8ba97b}.photo-add{border-color:#c9d5bd!important}.visibility-option.selected{border-color:#91aa7e}.label{color:#486645}.editor-actions .primary{background:#477b6d;border-radius:14rpx}


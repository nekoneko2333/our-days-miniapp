.editor{padding:30rpx 26rpx calc(40rpx + env(safe-area-inset-bottom))}.editor-heading{display:flex;flex-direction:column;gap:16rpx;padding:16rpx 6rpx 30rpx}.eyebrow{font-size:18rpx;letter-spacing:3rpx;color:#8b9c81}.heading{font-size:42rpx;font-weight:600;letter-spacing:1rpx}.notice{background:#eeeadd;color:#918165;padding:15rpx 20rpx;border-radius:12rpx;font-size:22rpx;margin-bottom:20rpx}.error{padding:20rpx;background:#f6e5df;color:#995b43;border-radius:12rpx;margin-bottom:20rpx;font-size:25rpx}.form-panel{background:#fdfef9;border:1rpx solid #e1e8d9;border-radius:22rpx;padding:28rpx;margin-bottom:22rpx}.label{font-size:27rpx;font-weight:600;display:block;margin-bottom:20rpx}.chips{display:flex;flex-wrap:wrap;gap:13rpx}.chip{padding:13rpx 22rpx;background:#f1f3eb;border-radius:25rpx;font-size:24rpx;color:#7c8a71}.chip.selected{background:#dce8d4;color:#486943}.date-inputs{display:flex;gap:22rpx;font-size:25rpx}.date-inputs picker{background:#f2f5ec;padding:9rpx;border-radius:8rpx}.form-panel textarea{min-height:120rpx;width:100%;font-size:26rpx;line-height:1.8;margin-bottom:20rpx;color:#45543e}.photos{display:flex;flex-wrap:wrap;gap:16rpx;margin:20rpx 0}.photo-cell{width:178rpx;height:178rpx;position:relative}.photo-cell>image{height:100%;width:100%;border-radius:12rpx}.photo-remove{position:absolute;top:-8rpx;right:-8rpx;background:#576f52!important;color:white!important;border-radius:50%!important;height:38rpx;width:38rpx;line-height:35rpx!important;font-size:28rpx!important;padding:0!important}.photo-add{width:178rpx;height:178rpx;background:#edf2e6!important;border:1rpx dashed #c4d0b9!important;border-radius:12rpx!important;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8rpx;color:#8a9b7c!important}.photo-add text:first-child{font-size:48rpx;line-height:1}.photo-add text:last-child{font-size:21rpx}.photo-save{position:absolute;bottom:0;left:0;right:0;font-size:19rpx!important;background:#29452685!important;color:white!important;line-height:1.8!important;border-radius:0 0 12rpx 12rpx!important}.photo-state{position:absolute;bottom:5rpx;left:5rpx;color:#a0543e;font-size:19rpx;background:#fff6ed}.visibility{display:flex;gap:18rpx}.visibility-option{flex:1;display:flex;align-items:flex-start;flex-direction:column;gap:12rpx;border:2rpx solid #e5ebdf;border-radius:15rpx;padding:22rpx 16rpx;font-size:26rpx}.visibility-option.selected{background:#eef4e8;border-color:#9cb58e}.visibility-option .muted{font-size:20rpx}.editor-actions{padding:0 8rpx}

page{background:#f7f8f2;color:#2c4032;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx}button{margin:0;padding:0;background:transparent;color:inherit;font-size:28rpx;font-weight:400;line-height:1.6;border-radius:0}button::after{border:none}button[disabled]{opacity:.5}view,text,button,input,textarea{box-sizing:border-box}.icon{width:32rpx;height:32rpx;flex-shrink:0}.icon.small{width:25rpx;height:25rpx}.muted{display:block;font-size:22rpx;line-height:1.65;color:#95a08d}.primary{background:#66876a;color:#fff;border-radius:16rpx;padding:20rpx 25rpx;font-size:28rpx;line-height:1.5;margin-top:20rpx}.secondary{background:#edf2e6;border:1rpx solid #d9e3cf;border-radius:14rpx;padding:17rpx 24rpx;font-size:26rpx;line-height:1.5;margin-top:18rpx}.arrow{width:48rpx;flex-shrink:0;font-size:40rpx;line-height:1.2;padding:5rpx}.text-button{padding:22rpx;font-size:24rpx;color:#87957c}.danger{color:#a77461}.field{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:23rpx 0;border-bottom:1rpx solid #edf0e7;font-size:25rpx}.field>text{flex-shrink:0;color:#77866b}.field input{flex:1;text-align:right;min-width:0;font-size:26rpx}.tap{opacity:.7}
/* WeChat v2 buttons have a built-in fixed width; size compact controls explicitly. */
button{width:auto!important}.primary,.secondary{width:100%!important}.arrow{width:48rpx!important;min-width:48rpx!important}.today-button{width:auto!important;flex-shrink:0}.fab{width:92rpx!important;min-width:92rpx!important}.quick{width:auto!important}.photo-add{width:178rpx!important}.photo-remove{width:38rpx!important}.photo-save{width:100%!important}
button,.tap,.tab,.record-list-row,.settings-row,.day-cell,.feed-record{transition:transform 160ms ease,opacity 160ms ease,background-color 200ms ease}
button:active,.tab:active,.record-list-row:active,.settings-row:active,.day-cell:active,.feed-record:active,.tap{transform:scale(.975);opacity:.8}
@media(prefers-reduced-motion:reduce){button,.tap,.tab,.record-list-row,.settings-row,.day-cell,.feed-record{transition:none;transform:none}}

@import "./theme.wxss";

@import "./landscape-controls.wxss";
